  writer.writeString(offsets[2], object.colorHex);
  writer.writeDateTime(offsets[3], object.createdAt);
  writer.writeLong(offsets[4], object.currentProgress);
  writer.writeString(offsets[5], object.description);
  writer.writeString(offsets[6], object.iconName);
  writer.writeBool(offsets[7], object.isNew);
  writer.writeBool(offsets[8], object.isUnlocked);
  writer.writeDouble(offsets[9], object.progressRatio);
  writer.writeLong(offsets[10], object.requiredThreshold);
  writer.writeLong(offsets[11], object.tier);
  writer.writeString(offsets[12], object.tierLabel);
  writer.writeString(offsets[13], object.title);
  writer.writeDateTime(offsets[14], object.unlockedAt);
